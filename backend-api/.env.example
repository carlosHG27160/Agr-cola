# Copia este archivo como ".env" y coloca tus datos reales de SQL Server.
# NUNCA subas el archivo ".env" real a un repositorio.

# Si usas una INSTANCIA CON NOMBRE (ej. "DESKTOP-AEVFHR7\SEKHARSQL" en SSMS):
#   DB_SERVER   = la parte antes de la barra invertida  -> DESKTOP-AEVFHR7
#   DB_INSTANCE = la parte después de la barra invertida -> SEKHARSQL
#   (deja DB_PORT sin usar / bórralo, no hace falta)
DB_SERVER=DESKTOP-AEVFHR7
DB_INSTANCE=SEKHARSQL

# Si en cambio usas la instancia por defecto (sin nombre) o una IP, usa DB_PORT
# en vez de DB_INSTANCE, y borra la línea DB_INSTANCE:
# DB_SERVER=localhost
# DB_PORT=1433

DB_DATABASE=BD_AGRICOLA
DB_USER=sa
DB_PASSWORD=carlos2007
DB_ENCRYPT=false
DB_TRUST_CERT=true

PORT=3000
